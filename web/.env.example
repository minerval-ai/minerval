# Minerval frontend (BFF) configuration.
# Copy to .env.local for local dev, or set in the Vercel project for deploys.

# Base URL of the Minerval Fastify API the BFF proxies to.
#   local backend:   http://localhost:3000
#   deployed:        https://<api-host>     (HTTPS once the ALB has a cert)
# Leave unset to run the frontend on design fixtures only.
MINERVAL_API_URL=

# API key the BFF sends as `x-api-key`. Mint a dedicated frontend key and add it
# to the backend's API_KEYS list so it can be rotated independently. Never expose
# this to the browser — it is read server-side only.
MINERVAL_API_KEY=

# --- Accounts / sign-in (issue #70) ------------------------------------------
# Auth.js session encryption secret. Generate with: openssl rand -base64 32
# Required in production; a fixed dev fallback is used locally.
AUTH_SECRET=

# OAuth providers — set a pair to enable that provider on /signin.
# GitHub: create an OAuth app with callback <site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google: callback <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Single sign-on through an organization's own identity provider (any that
# speaks OpenID Connect): set all three to enable it on /signin. The callback
# to register with the provider is <site>/api/auth/callback/oidc. The secret
# belongs here in the environment and in no file that is shared.
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
# What the sign-in button calls the provider ("Continue with ...").
AUTH_OIDC_NAME=
# Scopes to ask for. Add your provider's groups scope here if it sends groups
# only when asked (default: openid profile email).
AUTH_OIDC_SCOPE=
# The claim in the ID token that lists the person's groups (default: groups).
AUTH_OIDC_GROUPS_CLAIM=

# --- Members-only deployments -------------------------------------------------
# Set READS=members, here AND when the app is built, for a deployment whose
# API runs with READS=members (docs/accounts.md, "Members-only deployments").
# The app then asks every visitor to sign in, names the reader on every read,
# keeps no shared copy of any read, and never shows the design fixtures.
# Started with READS=members on a build made without it, it serves nothing
# and says why in its log. A build made with it also has the pages and the
# proxy of a private deployment, the files named *.members.ts(x), which no
# other build contains. Leave unset for a deployment anyone may read.
READS=
# How long a sign-in lasts, in hours, in a members-only deployment. Set it to
# the API's SIGN_IN_VALID_HOURS (default 12).
SIGN_IN_VALID_HOURS=

# Development-only username login (never active in production builds).
# Defaults to on in dev when no OAuth provider is configured; force with
# true/false.
AUTH_DEV_LOGIN=

# --- Contact form (issue #81) -------------------------------------------------
# Delivery for /about's contact form via SES (/api/contact). Both must be set
# or the form returns 503. CONTACT_FROM_EMAIL must be an SES-verified sender;
# standard AWS credentials/region env vars must also be available.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
