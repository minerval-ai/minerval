# The settings of a private Minerval run with deploy/compose.yml.
#
# Copy this file to deploy/.env and fill it in. docker compose reads .env
# from the directory compose.yml is in. Keep .env out of version control:
# it is where this deployment's secrets live, and no other file holds one.
#
# A line that is not commented out is a setting the deployment must give:
# `docker compose` stops and names it while it is empty. A line that is
# commented out has a starting value, stated beside it, and is set by
# removing the "#". Leave a setting commented out to leave it alone: an
# empty value is not the same as no value.
#
# This file names the settings a private deployment gives or is likely to
# change. The API reads many more (budgets, intervals, limits), each with a
# starting value; .env.example at the repository's root lists them. To set
# one of those, put it in deploy/api.env, which the API's container is given
# whole. docs/self-hosting.md walks through all of this in order.
#
# To make a secret:  openssl rand -base64 32

# =============================================================================
# 1. Where the deployment is reached
# =============================================================================

# The address people open the web app at, as their browser sees it, with no
# trailing slash. Sign-in sends people back to it, and links in what the
# deployment writes are made from it. Use https in front of anything but a
# trial on one machine (this package does not terminate TLS; put your own
# proxy in front).
SITE_URL=

# The address on this machine the two published ports listen on. 127.0.0.1
# keeps them to this machine, for a proxy on the same machine to reach.
# BIND_ADDRESS=127.0.0.1
# The port the web app is published on.
# WEB_PORT=3001
# The port the API (and MCP, at /mcp) is published on, for the
# organization's own agents and scripts.
# API_PORT=3000

# =============================================================================
# 2. The database
# =============================================================================

# The password of the Postgres server's superuser. It is used once, by the
# database container, to make the owner role, the database and two
# extensions when the data volume is first created. The API is never given
# it.
POSTGRES_PASSWORD=

# The password of `minerval_owner`, the role the API connects as. It owns
# the tables and is not a superuser. Letters and digits only: it is put
# into a connection address as it is.
DB_OWNER_PASSWORD=

# The password of `minerval_cleared`, the role every connection held to a
# clearance logs in as. Left out, it is derived from the owner's password,
# which needs nothing set. Set it, to any long random value, if the owner's
# password will be changed while the API is running.
# CLEARED_ROLE_PASSWORD=

# =============================================================================
# 3. Sign-in: your identity provider (OpenID Connect)
# =============================================================================

# The provider's issuer address. The web app reads the provider's
# configuration from <issuer>/.well-known/openid-configuration, so it must
# be reachable from the web container as well as from people's browsers.
AUTH_OIDC_ISSUER=
# The client id the provider gave this deployment. Register the callback
# <SITE_URL>/api/auth/callback/oidc with the provider.
AUTH_OIDC_ID=
# The client secret the provider gave this deployment.
AUTH_OIDC_SECRET=
# What the sign-in button calls the provider: "Continue with ...".
# AUTH_OIDC_NAME=
# The scopes asked for. Add the provider's groups scope if it sends groups
# only when asked. Starts as: openid profile email
# AUTH_OIDC_SCOPE=
# The claim in the ID token that lists a person's groups. Permissions can be
# granted to a group by the name it has there. Starts as: groups
# AUTH_OIDC_GROUPS_CLAIM=

# The secret the web app encrypts sign-in sessions with. Changing it signs
# everyone out.
AUTH_SECRET=

# How many hours a sign-in vouches for the groups it carried, after which
# the person signs in again. The API and the web app are both given it.
# SIGN_IN_VALID_HOURS=12

# The sign-in identity of the person setting the deployment up, written
# "oidc:<subject>", where the subject is the provider's `sub` for that
# person. The first time they sign in, while the deployment has never had an
# administrator, they are granted every permission, and hand them out from
# there. It works once. Someone who has signed in and holds nothing is shown
# their own identity, which is how to find the value: bring the deployment
# up without this, sign in, copy the identity shown, set it here, and run
# `docker compose up -d` again.
# FIRST_ADMINISTRATOR=oidc:

# =============================================================================
# 4. Keys between the deployment's own parts
# =============================================================================

# The key the web app presents to the API. The API trusts whoever holds it
# to say which signed-in person a request is for, so only the web app has
# it.
WEB_API_KEY=

# The token the API presents to the sandbox.
SANDBOX_TOKEN=

# The operator key: a few routes that are for whoever runs the deployment
# and not for any signed-in person need it. Left out, those routes are
# closed. It is never given to the web app.
# MINERVAL_OPERATOR_KEY=

# =============================================================================
# 5. Models
# =============================================================================
# Every run sends the text it reads to the provider of its model. Which
# provider serves a model follows from how the model's id is written
# (.env.example, "LLM SETTINGS"): an Anthropic id, an OpenAI id,
# "vendor/model" for OpenRouter, or "endpoint:<name>/<model>" for an
# endpoint this deployment runs (MODEL_ENDPOINTS, below).

# One key for each provider the deployment uses. A call routed to a
# provider with no key fails and names the key.
# ANTHROPIC_API_KEY=
# OpenAI's key also serves embeddings, which matching and search need.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Endpoints the deployment serves models from itself: anything that speaks
# the OpenAI Chat Completions API. A JSON list, one object for each: its
# name, its base URL, the NAME of the setting that holds its key (put that
# setting in api.env; leave keyEnv out if it takes none), and what a call
# costs in US dollars per million tokens, which has no starting value
# because budgets are counted in it.
# MODEL_ENDPOINTS=[{"name":"local","baseUrl":"http://models.internal:8000/v1","inputUsdPerMtok":0.5,"outputUsdPerMtok":1.5}]

# Which labels each provider and outside service may be sent text at: a
# JSON object from a name to a list of labels. The names are anthropic,
# openai, openrouter, endpoint:<name>, embeddings, web_search, web_pages,
# elicit and pangram. One that is not named is cleared for `public` alone,
# so nothing is served at a label you define until this clears a provider
# for it. A name that is no provider stops the API at start.
# PROVIDER_LABELS={"anthropic":["public","internal"],"embeddings":["public","internal"]}

# The model each of these roles runs on. There is no starting value:
# the API does not start until each is named, so that the roles a judgment
# rests on never run on a model nobody chose.
# The Steward: owns a node's page and reaches its assessment.
STEWARD_MODEL=
# The Steward's strong tier, for the decisions that move money.
STEWARD_STRONG_MODEL=
# The Curator: merges, splits and the links between nodes.
CURATOR_MODEL=
# Audit: samples decisions and reviews them.
AUDIT_MODEL=
# The Dispute Arbitrator: appeals and escalations.
ARBITRATION_MODEL=
# The Extractor: reads a source and proposes what the graph should hold.
EXTRACTOR_MODEL=
# The solver: attempts a proof of a formal statement. Where mathematics is
# on it has to be named, and it has to be one of the Anthropic models the
# solver's long-running loop can drive: the API does not start on any other,
# an endpoint of your own included. Where mathematics is switched off
# (FEATURES_OFF names it, below) leave this line as it is: no attempt runs,
# the setting is not read, and the deployment needs no Anthropic model to
# start. Compose cannot tell which case you are in, so it does not stop on
# this one: with mathematics on and no model here, the API says so at start.
# SOLVER_MODEL=

# The other roles each start on a model of public Minerval's own choosing,
# several of them served through OpenRouter. A deployment that uses one
# provider, or its own endpoint, names every one of them, or the role's runs
# fail for want of a key. The setup checklist page lists, for each label,
# the roles whose provider is not cleared for it.
# The Redactor: prepares a page for readers who do not read its label.
# Left out, it runs on the Steward's model.
# REDACTOR_MODEL=
# The Contribution Reviewer.
# GOVERNANCE_MODEL=
# The Grantmaker, and the program officers who work a mandate's inbox.
# GRANTMAKER_MODEL=
# PROGRAM_OFFICER_MODEL=
# The Matcher (whether the graph already holds a node) and the tagger.
# MATCHER_MODEL=
# TAGGER_MODEL=
# The Extractor's second model, used when the first refuses a document.
# EXTRACTOR_FALLBACK_MODEL=
# A mandate's lookouts and correspondents.
# LOOKOUT_MODEL=
# CORRESPONDENT_MODEL=
# The Consistency Checker, and its strong tier.
# CONSISTENCY_MODEL=
# CONSISTENCY_STRONG_MODEL=
# The Assistant (/ask): its main model, its standard tier, and the model
# that titles a conversation.
# ASSISTANT_MODEL=
# ASSISTANT_STANDARD_MODEL=
# ASSISTANT_TITLE_MODEL=
# The Researcher's three tiers.
# RESEARCHER_STRONG_MODEL=
# RESEARCHER_STANDARD_MODEL=
# RESEARCHER_CHEAP_MODEL=
# The browser extension's page analysis, where that feature is on.
# EXTENSION_MODEL=

# =============================================================================
# 6. What runs, and how work is paid for
# =============================================================================

# Parts of Minerval to switch off, comma-separated: extension, mathematics,
# prizes (prizes needs mathematics). A part that is off has no routes, no
# tools and no workers. Starts empty: everything is on.
# FEATURES_OFF=

# Where owls come from. "sold" is public Minerval's own setting: owls are
# bought through Stripe, which needs Stripe's keys (api.env). "created" is
# for a deployment that pays its own model providers: its administrators
# create owls, each act logged where every member can read it, and nothing
# is sold. With "sold" and no Stripe keys nothing can be bought, so a
# private deployment that pays its own providers sets "created".
# OWLS=sold

# Prices the deployment states for models, in US dollars per million
# tokens, for a model the built-in table does not know or in place of the
# table's. Where OWLS=created, a run on a model with no price is refused.
# MODEL_PRICES=[{"model":"<model id>","inputUsdPerMtok":0.5,"outputUsdPerMtok":1.5}]

# How much a run depends on its log. "best_effort": a step that cannot be
# written is logged and the run carries on, unsealed. "record": every run is
# traced in full, waits for its log to be sealed, and fails if the log could
# not be written whole.
# RUN_LOG_MODE=best_effort
# Days of agent traces kept; 0 keeps everything. Not applied under "record".
# TRACE_RETENTION_DAYS=30

# debug, info, warn or error.
# LOG_LEVEL=info

# =============================================================================
# 7. File sets and the sandbox
# =============================================================================
# The package fixes where uploaded sets are kept (a volume the API writes
# and the sandbox reads) and the sandbox's address.

# A directory on this machine whose subdirectories can be registered as
# file sets where they lie, for data too large to upload. It is mounted
# read-only into the API and the sandbox. The directory has no label: an
# administrator registers a directory under it and says then what label its
# files get. Files must be readable by uid 10002, the sandbox's user. Left
# out, no directory can be registered.
# REGISTERED_DIR=/srv/minerval-data

# The most bytes one uploaded set may hold. Starts at 10 GiB.
# FILE_SET_UPLOAD_MAX_BYTES=10737418240
# What an hour of a command's time is charged to its run's budget, in
# millionths of a US dollar. 0 charges nothing, and the run is told so.
# SANDBOX_HOUR_COST_MICRO_USD=50000

# The sandbox's own limits. Agents are told each one, with its reason, from
# what the running sandbox reports.
# Commands run at once; others wait.
# SANDBOX_MAX_COMMANDS=2
# The container's memory. At least SANDBOX_MEMORY_MB times
# SANDBOX_MAX_COMMANDS.
# SANDBOX_MEMORY_LIMIT=5g
# How much memory one command may use, in megabytes.
# SANDBOX_MEMORY_MB=2048
# How long one command may run, in seconds.
# SANDBOX_COMMAND_SECONDS=300
# How much one command may print, in bytes.
# SANDBOX_OUTPUT_BYTES=2000000
# How large one run's scratch directory, or one file in it, may be, in
# megabytes, and the size of the memory all scratch directories share.
# SANDBOX_SCRATCH_MB=1024
# SANDBOX_SCRATCH_SIZE=4g
# How long a command waits for a place before the call fails as busy.
# SANDBOX_QUEUE_SECONDS=60
# After how many hours unused a scratch directory is removed.
# SANDBOX_SCRATCH_IDLE_HOURS=24
# The name a kept analysis records for the image it ran in.
# SANDBOX_IMAGE=minerval-sandbox:local

# =============================================================================
# 8. The public graph
# =============================================================================
# All of this is optional. With none of it set the deployment holds no copy
# of the public graph and sends nothing out.

# A read-only mirror of the public graph, kept from its signed feed. The
# feed's address, the key presented when fetching it, and the public key(s)
# its batches are checked against (comma-separated). A batch that does not
# verify is not applied.
# MIRROR_FEED_URL=
# MIRROR_FEED_API_KEY=
# MIRROR_FEED_PUBLIC_KEYS=
# Seconds between fetches.
# MIRROR_APPLY_INTERVAL_SECONDS=300

# Where this deployment runs, stated on every page it shows outside:
# own_machines, minerval or third_party. There is no starting value, and no
# package of a page is built until it is set.
# DEPLOYMENT_HOSTING=
# The Ed25519 private key (PEM) that signs packages of pages shown outside.
# A lost key breaks the record of what the deployment has published, so
# keep a copy somewhere safe.
# PUBLISH_SIGNING_KEY=
# The public graph's API, and the key of the organization's own account
# there. Packages, proposals and anything else the organization does on the
# public graph go through this account. With the address left out, packages
# can still be carried as files.
# PUBLIC_GRAPH_API_URL=
# PUBLIC_GRAPH_API_KEY=
# The permission whose holders may act on the public graph in the
# organization's name: direct, fund or administer.
# PUBLIC_ACTS_BY=direct

# Which addresses the tools of a run that reads a private label take.
# "any" is where it starts: any address, as on the public graph. "given":
# only an address the deployment was given from outside (a search result, an
# address in a page the run read, a recorded source, a resolved identifier),
# used as it was given. Turning it on guards against text a run read telling
# it to fetch an address with private material written into it, which would
# hand that to whoever runs the address. It narrows that way out and does not
# close it: a search query is still text sent out. It costs research: a run
# cannot write the address for something it knows of, or reach the next page
# of results by editing one. Nearly every run in a private deployment reads
# private material, so "given" changes what almost all of them can fetch.
# PRIVATE_RUN_FETCHES=any

# A label's own posture: settings that are otherwise one for the deployment,
# given a value for one label's runs. A JSON object from a label's name to
# its settings: fetches ("any" or "given", as PRIVATE_RUN_FETCHES), sandbox
# (false = no command is run over a set of files by runs at that label) and
# features_off (features switched off for runs at that label, on top of
# FEATURES_OFF). A label that is not named works under the deployment's
# settings. This is how a label is set up as a room for sealed evidence.
# LABEL_POSTURE={"evidence-room":{"fetches":"given","sandbox":false}}

# How the deployment pays towards the public graph it reads. "metered":
# report the owls its runs spent each day, one total and nothing else.
# "flat": report nothing.
# PUBLIC_GRAPH_PRICE=metered
# Where reports are sent, and the key of the organization's account there.
# Left out, reports are prepared and kept until this is set.
# USAGE_REPORT_URL=
# USAGE_REPORT_API_KEY=
# The first day reported (YYYY-MM-DD). Left out: the first metered day.
# USAGE_REPORT_FROM=

# =============================================================================
# 9. Connections
# =============================================================================
# A connection (MCP read tools over data where it lives) is added in the
# web app, and names the setting that holds its credential. Such a setting's
# name starts with CONNECTION_ and it goes in deploy/api.env, for example:
#   CONNECTION_WAREHOUSE_TOKEN=...
