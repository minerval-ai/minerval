# The settings of a private Minerval run with deploy/compose.yml.
#
# Copy this file to deploy/.env, readable by your account alone, and fill
# it in:
#
#   install -m 600 env.example .env
#
# A plain `cp` leaves it readable by every account on the machine. The same
# goes for api.env, where you make one (install -m 600 /dev/null api.env).
# docker compose reads .env from the directory compose.yml is in. Keep .env out of version control:
# it is where this deployment's secrets live, and no other file holds one.
# Back it up (and api.env) off the machine, in a password manager or a
# secrets store: it is in no Docker volume, and DB_OWNER_PASSWORD and
# PUBLISH_SIGNING_KEY cannot be made again without cost (docs/self-hosting.md,
# "No backups").
#
# A line that is not commented out is a setting the deployment must give:
# `docker compose` stops and names it while it is empty. A line that is
# commented out has a starting value, stated beside it, and is set by
# removing the "#". Leave a setting commented out to leave it alone: an
# empty value is not the same as no value.
#
# This file holds what stays on the machine (docs/settings.md, "What stays
# on the machine"): where the deployment is reached, the database, sign-in,
# the secrets between its own parts, and the directories and limits of the
# machine itself. Whoever runs the machine sets these, here.
#
# Everything else is a choice about how the deployment works, and is its
# administrators': which model serves each role, the model providers' keys,
# which features are on, where owls come from, budgets, intervals, limits.
# They set those in the web app, on Settings, once the deployment is
# running; nothing about them needs to be here. Section 5 says how to fix
# one from the machine all the same, for an install that is scripted.
# docs/self-hosting.md walks through all of this in order.
#
# To make a secret:  openssl rand -base64 32

# =============================================================================
# 1. Where the deployment is reached
# =============================================================================

# The address people open the web app at, as their browser sees it, with no
# trailing slash. Sign-in sends people back to it, and links in what the
# deployment writes are made from it. Use https in front of anything but a
# trial on one machine (this package does not terminate TLS; put your own
# proxy in front).
SITE_URL=

# The address on this machine the two published ports listen on. 127.0.0.1
# keeps them to this machine, for a proxy on the same machine to reach.
# BIND_ADDRESS=127.0.0.1
# The port the web app is published on.
# WEB_PORT=3001
# The port the API (and MCP, at /mcp) is published on, for the
# organization's own agents and scripts.
# API_PORT=3000
# The HTTPS address the API is reached at from the internet, through a
# reverse proxy of yours, such as https://api.example.org. MCP clients are
# told to register and sign in there, and members connect at it followed by
# /mcp. It is not SITE_URL: the web app refuses anyone not signed in, and a
# client registering itself is not. Hosted clients (Claude.ai, Cowork)
# connect from their provider's servers, so without it they cannot connect;
# the Health page's check `mcp_address` says so. Left out, it is
# http://localhost:3000, which works only for clients on this machine.
# API_URL=

# =============================================================================
# 2. The database
# =============================================================================

# The password of the Postgres server's superuser. It is used once, by the
# database container, to make the owner role, the database and two
# extensions when the data volume is first created. The API is never given
# it.
POSTGRES_PASSWORD=

# The password of `minerval_owner`, the role the API connects as. It owns
# the tables and is not a superuser. Letters and digits only: it is put
# into a connection address as it is.
DB_OWNER_PASSWORD=

# The password of `minerval_cleared`, the role every connection held to a
# clearance logs in as. Left out, it is derived from the owner's password,
# which needs nothing set. Set it, to any long random value, if the owner's
# password will be changed while the API is running.
# CLEARED_ROLE_PASSWORD=

# =============================================================================
# 3. Sign-in: your identity provider (OpenID Connect)
# =============================================================================

# The provider's issuer address. The web app reads the provider's
# configuration from <issuer>/.well-known/openid-configuration, so it must
# be reachable from the web container as well as from people's browsers.
AUTH_OIDC_ISSUER=
# The client id the provider gave this deployment. Register the callback
# <SITE_URL>/api/auth/callback/oidc with the provider.
AUTH_OIDC_ID=
# The client secret the provider gave this deployment.
AUTH_OIDC_SECRET=
# What the sign-in button calls the provider: "Continue with ...".
# AUTH_OIDC_NAME=
# The scopes asked for. Add the provider's groups scope if it sends groups
# only when asked. Starts as: openid profile email
# AUTH_OIDC_SCOPE=
# The claim in the ID token that lists a person's groups. Permissions can be
# granted to a group by the name it has there. Starts as: groups
# AUTH_OIDC_GROUPS_CLAIM=

# The secret the web app encrypts sign-in sessions with. Changing it signs
# everyone out.
AUTH_SECRET=

# How many hours a sign-in vouches for the groups it carried, after which
# the person signs in again. The API and the web app are both given it.
# SIGN_IN_VALID_HOURS=12

# The sign-in identity of the person setting the deployment up, written
# "oidc:<subject>", where the subject is the provider's `sub` for that
# person. The first time they sign in, while the deployment has never had an
# administrator, they are granted every permission, and hand them out from
# there. It works once. Someone who has signed in and holds nothing is shown
# their own identity, which is how to find the value: bring the deployment
# up without this, sign in, copy the identity shown, set it here, and run
# `docker compose up -d` again.
# FIRST_ADMINISTRATOR=oidc:

# The names of the two labels every deployment has beside `public`: the
# organization's own material that every member reads, and what it released
# outside. Leave these unset: they are `members` and `published`, which is
# what the documentation and the agents call them. They are read once, when
# the deployment first starts on a version that has the two labels, and
# matter only if you had already defined a label of your own with one of
# those names: the API then stops at start and says which of these to set.
# MEMBERS_LABEL=
# PUBLISHED_LABEL=

# =============================================================================
# 4. Keys between the deployment's own parts
# =============================================================================

# The key the web app presents to the API. The API trusts whoever holds it
# to say which signed-in person a request is for, so only the web app has
# it.
WEB_API_KEY=

# The token the API presents to the sandbox.
SANDBOX_TOKEN=

# The operator key: a few routes that are for whoever runs the deployment
# and not for any signed-in person need it. Left out, those routes are
# closed. It is never given to the web app.
# MINERVAL_OPERATOR_KEY=

# =============================================================================
# 5. What the administrators set in the app
# =============================================================================
# The models, the model providers' keys, the features, owls and prices, the
# outside services, and every budget, interval and limit are set on the
# Settings page (/admin/settings) by the deployment's administrators. Each
# change is checked, logged and, for most, in force within seconds. Health's
# first day asks for the ones a new deployment must decide: the
# organization's name and the model of each load-bearing role.
#
# To fix one of them from the machine instead, so that the app shows it and
# does not offer to change it, put its line in deploy/api.env, which the
# API's container is given whole, or in the config file (docs/deployment.md).
# The lines this file used to hold for them (STEWARD_MODEL, ANTHROPIC_API_KEY,
# FEATURES_OFF, OWLS and the rest) still work in .env if a deployment has
# them there: a setting whoever runs the machine sets is fixed, as before.
# docs/settings.md lists every setting and where it may be set.

# The key that seals what is given in the app: the model providers' keys and
# the other keys someone outside issued, given on Settings, and a
# connection's credential, given on its page. 32 random bytes, made with
# `openssl rand -base64 32`. Set it before the deployment's first start:
# without it no key can be given in the app, and each would have to be put
# in api.env. Losing it loses only what was sealed, which is then given
# again. To replace it, move the old one to
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS, set a new one, restart, run
# scripts/reseal-connection-credentials.ts (which reseals the settings'
# keys too), then remove the old one.
# CREDENTIAL_ENCRYPTION_KEY=
# Keys that sealed before the current one, comma-separated: they open, never
# seal.
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# Which labels each provider and outside service may be sent text at.
# Leave this unset: your administrators then choose it in the web app, on
# the labels page where each label is defined, with nothing cleared for a
# label until someone ticks it, and a change takes effect without a
# restart. Set it only if that choice is to be made here alone: set, it
# overrides the page and fixes the clearance, and the page says so. It is
# a JSON object from a name to a list of labels. The names are anthropic,
# openai, openrouter, endpoint:<name>, embeddings, web_search, web_pages,
# elicit and pangram. One that is not named is cleared for `public` alone.
# A name that is no provider stops the API at start.
#
# `public` here is the public graph's own material. Your organization's own
# work is at `members` (what every member reads, and where work that names
# no other label is done) and `published` (what it released outside), so a
# provider that is to serve your agents needs both on its line. A deployment
# set up before those two labels existed has to add them here by hand: the
# preflight's provider_labels check fails, and says which lines to change,
# until it does.
# PROVIDER_LABELS={"anthropic":["public","published","members","internal"],"embeddings":["public","published","members","internal"]}

# How much a run depends on its log. "record", where this package starts:
# every run is traced in full, waits for its log to be sealed, and fails if
# the log could not be written whole. "best_effort": a step that cannot be
# written is logged and the run carries on, unsealed. Once you define a
# label, no agent work starts under best_effort, so leave this as it is.
# RUN_LOG_MODE=record

# The Ed25519 private key (PEM) that signs packages of pages shown outside.
# It is the deployment's own, and is what a reader outside trusts, so it
# stays on the machine. A lost key breaks the record of what the deployment
# has published, so keep a copy somewhere safe.
# PUBLISH_SIGNING_KEY=

# =============================================================================
# 6. File sets and the sandbox
# =============================================================================
# The package fixes where uploaded sets are kept (a volume the API writes
# and the sandbox reads) and the sandbox's address.

# A directory on this machine whose subdirectories can be registered as
# file sets where they lie, for data too large to upload. It is mounted
# read-only into the API and the sandbox. The directory has no label: an
# administrator registers a directory under it and says then what label its
# files get. Files must be readable by uid 10002, the sandbox's user. Left
# out, no directory can be registered.
# REGISTERED_DIR=/srv/minerval-data


# The sandbox's own limits. Agents are told each one, with its reason, from
# what the running sandbox reports.
# Commands run at once; others wait.
# SANDBOX_MAX_COMMANDS=2
# The container's memory. At least SANDBOX_MEMORY_MB times
# SANDBOX_MAX_COMMANDS.
# SANDBOX_MEMORY_LIMIT=5g
# How much memory one command may use, in megabytes.
# SANDBOX_MEMORY_MB=2048
# How long one command may run, in seconds.
# SANDBOX_COMMAND_SECONDS=300
# How much one command may print, in bytes.
# SANDBOX_OUTPUT_BYTES=2000000
# How large one run's scratch directory, or one file in it, may be, in
# megabytes, and the size of the memory all scratch directories share.
# SANDBOX_SCRATCH_MB=1024
# SANDBOX_SCRATCH_SIZE=4g
# How long a command waits for a place before the call fails as busy.
# SANDBOX_QUEUE_SECONDS=60
# After how many hours unused a scratch directory is removed.
# SANDBOX_SCRATCH_IDLE_HOURS=24
# The name a kept analysis records for the image it ran in.
# SANDBOX_IMAGE=minerval-sandbox:local

# =============================================================================
# 7. Connections
# =============================================================================
# A connection (MCP read tools over data where it lives) is added in the
# web app. Its credential is given on the connection's page, where it is
# kept sealed under CREDENTIAL_ENCRYPTION_KEY (section 5), or in a setting
# the connection names, whose name starts with CONNECTION_ and which goes in
# deploy/api.env, for example:
#   CONNECTION_WAREHOUSE_TOKEN=...
