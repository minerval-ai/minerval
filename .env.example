# Minerval Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development  # development | staging | production

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL with pgvector
DATABASE_URL=postgres://episteme:episteme_dev@localhost:5432/episteme

# =============================================================================
# AWS
# =============================================================================
AWS_REGION=us-east-1

# =============================================================================
# API SETTINGS
# =============================================================================
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Agent trace persistence (#334 L0): "full" records agent_runs/agent_steps
# (the whole tool-use transcript), "off" records nothing. Unset: off in
# production, full in dev and the corpus harness.
# TRACE_LEVEL=full
# Enqueue-event telemetry (#217): one tiny row per enqueue. Unset: on
# everywhere (production included); "off" disables.
# ENQUEUE_EVENTS=on
# Hours between persisted queue-depth snapshots (#217). 0 disables.
# QUEUE_DEPTH_SAMPLE_INTERVAL_HOURS=6
# Comma-separated operator API keys (bootstrap / first-party). Bind a key to a
# contributor identity with "key:contributor_external_id" — contribution/appeal
# endpoints act as the contributor bound to the presented key (issue #10).
# Env keys are SERVICE-TRUSTED: they may act on behalf of a signed-in user via
# the x-acting-user header (this is how the web frontend's BFF authenticates).
# End-user keys are DB-backed and minted from the dashboard (issue #70) — env
# keys are only for operators and first-party services.
# With no keys configured (non-production only), auth is bypassed and requests
# act as the local "dev:local" account.
API_KEYS=dev-api-key:dev:local

# =============================================================================
# ACCOUNTS / METERING (issue #70)
# =============================================================================
# Monthly free-tier grant for METERED (agentic/LLM-backed) usage, in USD of
# derived token cost. Non-agentic reads are never metered. 0 disables the
# trial entirely (agentic endpoints return 402 until credits exist).
# FREE_TIER_MONTHLY_USD=5
# Per-key rate limit on agentic endpoints (requests/hour, 0 = unlimited).
# AGENTIC_RATE_LIMIT_PER_HOUR=30

# =============================================================================
# LLM SETTINGS
# =============================================================================
# API keys, one per provider. A call routed to a provider with no key fails with
# a configuration error naming the missing key.
# ANTHROPIC_API_KEY=      # "claude-…" models
# OPENAI_API_KEY=         # "gpt-…"/"o3" models AND embeddings (one key, both uses)
# OPENROUTER_API_KEY=     # "vendor/model" ids, e.g. qwen/qwen3-235b-a22b
#
# Override default models. Which provider serves a model is decided by the shape
# of its ID (see docs/architecture.md § Providers and src/llm/providers/routing.ts):
#   claude-…        -> Anthropic direct        e.g. claude-fable-5-1
#   gpt-… or o<n>   -> OpenAI direct           e.g. gpt-5-nano, o3
#   vendor/model    -> OpenRouter              e.g. qwen/qwen3-235b-a22b
# Anything else is rejected at config load — including Bedrock "us.anthropic.*"
# IDs, which 404 against the Anthropic API.
# Note: server tools (web_search), containers, and the Opus refusal fallback are
# Anthropic-only. The Claim Steward uses web_search, so STEWARD_MODEL must stay
# on a "claude-…" model.
# Production runs the load-bearing agents on Fable 5.1 (deep-judgment roles where
# the capability jump matters; priced above Opus, so scoped to these — issue #77).
# Note: Fable 5.1 requires the org to allow 30-day data retention (ZDR orgs get a
# 400 on every request).
# STEWARD_MODEL=claude-fable-5-1
# The strong tier: the model the Steward's six money triggers (formalize,
# formalization_review, prize_claim, prize_claim_voided, prize_window_closed,
# attempt_completed) always run on (docs/mathematics.md §6.4), and the
# 'strong' variant on the action ledger when set (docs/allocation.md). Guarded
# in production like the envs above: a money decision never runs on the
# standard tier.
# STEWARD_STRONG_MODEL=claude-fable-5-1
# CURATOR_MODEL=claude-fable-5-1
# AUDIT_MODEL=claude-fable-5-1
# ARBITRATION_MODEL=claude-fable-5-1
# MATCHER_MODEL=claude-haiku-4-5-20251001
# GOVERNANCE_MODEL=claude-sonnet-5
# The solver (docs/mathematics.md §7) is strong-tier only and guarded in
# production like the envs above; SOLVER_MODEL is set in the MATHEMATICS:
# THE SOLVER section below.

# =============================================================================
# ELICIT CONNECTOR (issue #299)
# =============================================================================
# Scholarly search for the Claim Steward over Elicit's remote MCP server.
# Opt-in per deployment: empty/unset disables the connector entirely (the
# Steward's toolset omits the elicit_* tools). Calls cost real money beyond
# tokens.
# ELICIT_API_KEY=
# ELICIT_MCP_URL=https://elicit.com/api/mcp
# Importance gate: only claims at or above this get the Elicit tools.
# STEWARD_ELICIT_MIN_IMPORTANCE=0.75
# Per-run cap on Elicit calls (0 = uncapped).
# STEWARD_ELICIT_MAX_CALLS_PER_RUN=3

# =============================================================================
# DOMAIN SKILLS (docs/mathematics.md §3, §6.2)
# =============================================================================
# Per-run backstops on the Lean tools the Mathematics skill brings to the
# Steward (0 = uncapped). A "fresh" replay of lean_check counts double.
# STEWARD_LEAN_MAX_SEARCHES_PER_RUN=12
# STEWARD_LEAN_MAX_ELABORATIONS_PER_RUN=10
# STEWARD_LEAN_MAX_CHECKS_PER_RUN=3
# Prompt cache lifetime for the cached system blocks: 5m (default) or 1h.
# PROMPT_CACHE_TTL=5m

# =============================================================================
# MATHEMATICS: LEAN CHECKER (docs/mathematics.md §5, §6.3)
# =============================================================================
# The lean-checker service's private base URL and bearer token. Empty URL =
# no checker: the Lean tools are absent, nothing publishes, nothing checks.
# LEAN_CHECKER_URL=
# LEAN_CHECKER_TOKEN=
# Metering: a check bills from the checker's wall time at this per-CPU-hour
# price (micro-USD; default ≈ one hour of a 4 vCPU Fargate task) plus a
# fixed per-job overhead, into llm_usage like token spend.
# LEAN_CPU_HOUR_COST_MICRO_USD=200000
# LEAN_CHECK_OVERHEAD_MICRO_USD=20000
# A published statement is public this long before any bounty binds to it;
# a challenge upheld during the period earns the fixed award (USD).
# FORMALIZATION_REVIEW_PERIOD_DAYS=14
# FORMALIZATION_REVIEW_AWARD_USD=100

# =============================================================================
# MATHEMATICS: THE SOLVER (docs/mathematics.md §7)
# =============================================================================
# Strong tier only (the long-run loop needs effort, streaming, and the
# long-run betas); production must set it explicitly like the other
# load-bearing model envs.
# SOLVER_MODEL=claude-fable-5-1
# Kill switch: the solver worker exits its loop when not "true".
# SOLVER_ENABLED=false
# Durable daily spend cap on the solver, in owls, independent of any
# mandate; the lower cap applies during calibration runs.
# SOLVER_DAILY_CAP_OWLS=400
# SOLVER_CALIBRATION_DAILY_CAP_OWLS=100
# Per-attempt caps on Lean tool calls (0 = uncapped).
# SOLVER_LEAN_MAX_CHECKS=60
# SOLVER_LEAN_MAX_ELABORATIONS=200
# Per-attempt ceiling = cost estimate × (1 + fraction); wall and iteration
# caps guarantee termination.
# ATTEMPT_OVERAGE_FRACTION=0.25
# ATTEMPT_MAX_WALL_HOURS=6
# ATTEMPT_MAX_ITERATIONS=500
# Agents always traced regardless of TRACE_LEVEL (comma-separated): the
# solver's transcript is prize-review evidence.
# TRACE_ALWAYS_AGENTS=math_solver

# =============================================================================
# MATHEMATICS: BOUNTIES AND PRIZES (docs/mathematics.md §8)
# =============================================================================
# Per-claim bounty bounds (USD); the maximum is raised only by configuration
# after counsel's items.
# MAX_BOUNTY_PER_CLAIM_USD=5000
# MIN_BOUNTY_PER_CLAIM_USD=250
# How much of the prize fund the Grantmaker may commit per review pass and
# per UTC day, as fractions of the fund's balance.
# BOUNTY_POOL_FRACTION_PER_PASS=0.1
# BOUNTY_POOL_FRACTION_PER_DAY=0.25
# A posting at or above this (USD) waits for a person's confirmation.
# BOUNTY_AUTONOMY_THRESHOLD_USD=1000
# Withdrawal notice and default expiry, in days.
# BOUNTY_NOTICE_DAYS=30
# BOUNTY_DEFAULT_EXPIRY_DAYS=365
# Human sign-off before payment at or above this amount (USD) or importance.
# PRIZE_HUMAN_SIGNOFF_USD=1000
# PRIZE_HUMAN_SIGNOFF_IMPORTANCE=0.6
# The challenge window between acceptance and payment: small below the tier,
# large at or above it, never under 14 days.
# PRIZE_CHALLENGE_WINDOW_DAYS_SMALL=14
# PRIZE_CHALLENGE_WINDOW_DAYS_LARGE=30
# PRIZE_WINDOW_TIER_USD=1000
# Days a winner has to complete identity, tax form, and screening.
# PRIZE_PAYEE_STEPS_DAYS=90
# Owls minted at cost into the prize-review job when a bounty opens, as a
# fraction of the bounty.
# PRIZE_REVIEW_RESERVE_FRACTION=0.10
# A statement defect exposed by a claimant earns this fraction of the
# bounty, capped (USD).
# PRIZE_DEFECT_AWARD_FRACTION=0.10
# PRIZE_DEFECT_AWARD_CAP_USD=500
# Owl prizes above this (USD) are granted in daily tranches of at most it.
# PRIZE_OWL_TRANCHE_USD=2000
# The prize-check worker: concurrent cold-lane checks, checks per day, the
# reclaim window (minutes) for a dead worker's row, and checker-error
# retries before check_error holds the statement's queue.
# PRIZE_CHECK_MAX_CONCURRENT=2
# PRIZE_CHECKS_PER_DAY=50
# PRIZE_CHECK_RECLAIM_MINUTES=30
# PRIZE_CHECK_MAX_ATTEMPTS=3
# Filing limits: per statement per 30 days, and per day platform-wide.
# PRIZE_CLAIMS_PER_STATEMENT_PER_30_DAYS=3
# PRIZE_CLAIMS_PER_DAY_PLATFORM=5
# The operator key (§8.11): fund deposits, bounty confirmations, prize-claim
# sign-offs, and voids require it. NEVER deployed to the web tier; used only
# from the operator's own session. Empty = those routes are closed.
# MINERVAL_OPERATOR_KEY=
# The Mathematics mandate's sizing (§10.7), read by the seed: escrow (owls at
# cost), daily rate (must exceed one max attempt's prior), and the first
# prize-fund deposit (USD).
# MATH_MANDATE_ESCROW_OWLS=2500
# MATH_MANDATE_DAILY_OWLS=200
# MATH_PRIZE_POOL_USD=2500

# =============================================================================
# PROCESSING SETTINGS
# =============================================================================
# MAX_DECOMPOSITION_DEPTH=5
# MATCHING_SIMILARITY_THRESHOLD=0.85
# Quantity caps to bound graph fan-out (0 = unlimited). Turn these DOWN for fast,
# cheap iteration on prompts; leave at 0 for a faithful full run.
# EXTRACTION_MAX_CLAIMS=0       # most-central claims per document
# MAX_SUBCLAIMS_PER_CLAIM=0     # subclaims per decomposition (tree width)

# =============================================================================
# GOVERNANCE SETTINGS
# =============================================================================
# ENABLE_CONTRIBUTIONS=false
# AUDIT_SAMPLE_RATE=0.05

# =============================================================================
# SQS QUEUES (production only -- local dev uses in-memory queues)
# =============================================================================
# SQS_CLAIM_PIPELINE_QUEUE=
# SQS_URL_EXTRACTION_QUEUE=
# SQS_CONTRIBUTION_QUEUE=
# SQS_ARBITRATION_QUEUE=
# SQS_STEWARD_QUEUE=
# SQS_AUDIT_QUEUE=
