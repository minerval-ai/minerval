# Minerval Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development  # development | staging | production

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL with pgvector
DATABASE_URL=postgres://episteme:episteme_dev@localhost:5432/episteme

# =============================================================================
# AWS
# =============================================================================
AWS_REGION=us-east-1

# =============================================================================
# API SETTINGS
# =============================================================================
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Agent trace persistence (#334 L0): "full" records agent_runs/agent_steps
# (the whole tool-use transcript), "off" records nothing. Unset: full
# everywhere, production included (off only under vitest).
# TRACE_LEVEL=full
# Features to switch off, comma-separated: extension, mathematics, prizes
# (src/features.ts; prizes needs mathematics). Empty: everything is on. A
# feature that is off has no routes, no tools and no workers. An unknown name
# stops the process at start.
# FEATURES_OFF=
# Who this deployment serves (src/permissions.ts; docs/accounts.md,
# "Members-only deployments"). "open", the default, is the public graph: a
# read needs no account. "members" serves nothing to anyone who is not signed
# in, and what a signed-in person may do follows from the permissions the
# deployment's administrators grant. Set the web app's READS to the same.
# READS=open
# The sign-in identity ("<provider>:<subject>") of the person setting a
# members-only deployment up. The first time they sign in, while the
# deployment has never had an administrator, they are granted every
# permission. It works once. A person who has signed in and holds nothing is
# shown their own identity.
# FIRST_ADMINISTRATOR=
# Hours a sign-in vouches for the groups it carried, in a members-only
# deployment. Set the web app's SIGN_IN_VALID_HOURS to the same.
# SIGN_IN_VALID_HOURS=12

# Where owls come from (docs/accounts.md, "Owls a deployment creates for
# itself"). "sold" is the public graph: owls are bought through Stripe.
# "created" is for a deployment that pays its own model providers: its
# administrators create owls, each act logged, and nothing is sold. It needs
# READS=members and refuses to start beside a Stripe key.
# OWLS=sold
# Prices this deployment states for models, in US dollars per million
# tokens: for a model the built-in table does not know, or in place of the
# table's. Where OWLS=created, a model with no price is refused.
# MODEL_PRICES=[{"model":"gpt-oss-120b","inputUsdPerMtok":0.5,"outputUsdPerMtok":1.5}]

# The usage report (docs/usage-report.md), in a members-only deployment.
# "metered": report the owls the deployment's runs spent each UTC day to the
# public graph, one total and nothing else. "flat": report nothing.
# PUBLIC_GRAPH_PRICE=metered
# Where reports go: the public graph's receiving route with an API key of
# the organization's account there, or a directory to write them to as
# files for handing over. One or the other.
# USAGE_REPORT_URL=
# USAGE_REPORT_API_KEY=
# USAGE_REPORT_DIR=
# The first UTC day reported (YYYY-MM-DD); empty means the first metered day.
# USAGE_REPORT_FROM=
# USAGE_REPORT_INTERVAL_SECONDS=3600
# Days of agent traces the retention sweep keeps; 0 keeps everything.
# TRACE_RETENTION_DAYS=30
# How much a run depends on its log (docs/run-log.md). "best_effort": a step
# that cannot be written is logged and the run carries on, unsealed.
# "record": every run is traced in full, waits for its log to be sealed, and
# fails if the log could not be written whole; nothing is expired.
# RUN_LOG_MODE=best_effort
# Enqueue-event telemetry (#217): one tiny row per enqueue. Unset: on
# everywhere (production included); "off" disables.
# ENQUEUE_EVENTS=on

# =============================================================================
# CORPUS HARNESS (scripts/corpus, corpus/README.md)
# =============================================================================
# The isolated database every corpus script pins itself to; never the main graph.
# CORPUS_DATABASE_URL=postgresql://episteme:episteme_dev@localhost:5432/episteme_corpus
# Run on the production model pins from infra/lib/api-stack.ts (same as
# --profile=production). Overrides any *_MODEL below; needs a key for every
# provider the pins route to.
# CORPUS_PROFILE=production
# The scorecard's LLM judge. Must differ from the Steward model the graph was
# built with (corpus:score refuses otherwise) — on the config defaults that
# means anything but Sonnet.
# JUDGE_MODEL=claude-opus-4-8
# Hours between persisted queue-depth snapshots (#217). 0 disables.
# QUEUE_DEPTH_SAMPLE_INTERVAL_HOURS=6
# Comma-separated operator API keys (bootstrap / first-party). Bind a key to a
# contributor identity with "key:contributor_external_id" — contribution/appeal
# endpoints act as the contributor bound to the presented key (issue #10).
# Env keys are SERVICE-TRUSTED: they may act on behalf of a signed-in user via
# the x-acting-user header (this is how the web frontend's BFF authenticates).
# End-user keys are DB-backed and minted from the dashboard (issue #70) — env
# keys are only for operators and first-party services.
# With no keys configured (non-production only), auth is bypassed and requests
# act as the local "dev:local" account.
API_KEYS=dev-api-key:dev:local

# =============================================================================
# ACCOUNTS / METERING (issue #70)
# =============================================================================
# Monthly free-tier grant for METERED (agentic/LLM-backed) usage, in USD of
# derived token cost. Non-agentic reads are never metered. 0 disables the
# trial entirely (agentic endpoints return 402 until credits exist).
# FREE_TIER_MONTHLY_USD=5
# Per-key rate limit on unpriced agentic traffic (service calls with no acting
# user), requests/hour, 0 = unlimited. A user's calls are bounded by their balance.
# AGENTIC_RATE_LIMIT_PER_HOUR=30

# =============================================================================
# LLM SETTINGS
# =============================================================================
# API keys, one per provider. A call routed to a provider with no key fails with
# a configuration error naming the missing key.
# ANTHROPIC_API_KEY=      # "claude-…" models
# OPENAI_API_KEY=         # "gpt-…"/"o3" models AND embeddings (one key, both uses)
# OPENROUTER_API_KEY=     # "vendor/model" ids, e.g. qwen/qwen3-235b-a22b
#
# Override default models. Which provider serves a model is decided by the shape
# of its ID (see docs/architecture.md § Providers and src/llm/providers/routing.ts):
#   claude-…        -> Anthropic direct        e.g. claude-opus-5-5
#   gpt-… or o<n>   -> OpenAI direct           e.g. gpt-5-nano, o3
#   vendor/model    -> OpenRouter              e.g. qwen/qwen3-235b-a22b
#   endpoint:<name>/<model> -> an endpoint declared in MODEL_ENDPOINTS (below)
# Anything else is rejected at config load — including Bedrock "us.anthropic.*"
# IDs, which 404 against the Anthropic API.
#
# Endpoints this deployment serves models from itself: anything with an
# OpenAI-compatible Chat Completions API (vLLM, llama.cpp's server, TGI,
# Ollama). A JSON list, one object per endpoint: its name, its base URL, the
# NAME of the environment variable that holds its key (leave keyEnv out if it
# takes none), and what a call costs in US dollars per million tokens, which
# has no default because budgets and owls are counted in it. A model is routed
# to one by writing its ID as endpoint:<name>/<model as the endpoint knows it>.
# MODEL_ENDPOINTS=[{"name":"local","baseUrl":"http://localhost:8000/v1","keyEnv":"LOCAL_LLM_KEY","inputUsdPerMtok":0.5,"outputUsdPerMtok":1.5}]
# STEWARD_MODEL=endpoint:local/meta-llama/Llama-3.3-70B-Instruct
#
# Which labels each model provider and outside service may receive text at
# (docs/architecture.md § Providers cleared by label). A JSON object from a
# name to a list of labels. The names: anthropic, openai, openrouter,
# endpoint:<name> for each endpoint above, embeddings, web_search, web_pages,
# elicit, pangram. One not named is cleared for "public" only, so a deployment
# with another label serves nothing at it until this clears a provider for it.
# One that is named is cleared for exactly the labels listed ([] for none).
# An unknown name stops the process at start; a label that is not defined is
# reported on the first call.
# PROVIDER_LABELS={"anthropic":["public","internal"],"embeddings":["public","internal"]}
# Note: server tools (web_search), containers, and the Opus refusal fallback are
# Anthropic-only. Agents that use web_search (Claim Steward, mandate review,
# lookouts) get it only on a "claude-…" model and run without it elsewhere,
# saying so in their reasoning; the solver's long-run loop is Claude-only.
# Production runs the load-bearing agents on Opus 5.5 (deep-judgment roles where
# the capability jump matters; priced above Sonnet, so scoped to these — issue #77),
# and the few highest-stakes ones on Fable 5.2 at twice the price: the Steward's
# strong tier, arbitration, the solver, and (by default) the Grantmaker and the
# researcher's strong tier.
# STEWARD_MODEL=claude-opus-5-5
# The strong tier: the model the Steward's six money triggers (formalize,
# formalization_review, prize_claim, prize_claim_voided, prize_window_closed,
# attempt_completed) always run on (docs/mathematics.md §6.4), and the
# 'strong' variant on the action ledger when set (docs/allocation.md). Guarded
# in production like the envs above: a money decision never runs on the
# standard tier.
# STEWARD_STRONG_MODEL=claude-fable-5-2
# CURATOR_MODEL=claude-opus-5-5
# AUDIT_MODEL=claude-opus-5-5
# ARBITRATION_MODEL=claude-fable-5-2
# MATCHER_MODEL=   # defaults to the cheap tier (OPENROUTER_MODELS.flash in src/llm/models.ts); needs OPENROUTER_API_KEY
# MATCHER_BUDGET_USD=0.1   # what one Matcher decision may spend; the binding limit on its searching (a turn guard of 30 is the backstop)
# GOVERNANCE_MODEL=claude-sonnet-5-5
# The tagger (#272) — the nano tier. Topic tags over every claim, no epistemic
# judgment, so the cheapest capable model is right in production too; it
# shares the Matcher's tier and key requirement.
# TAGGER_MODEL=   # defaults to the cheap tier (OPENROUTER_MODELS.flash); needs OPENROUTER_API_KEY
# The tagging drain: a tick every N seconds tags up to TAGGING_BATCH_SIZE
# untagged claims, most important first (0 seconds disables tagging).
# TAGGING_INTERVAL_SECONDS=30
# TAGGING_BATCH_SIZE=5
# The Lookout (docs/allocation.md, "Lookouts") — a mandate's cheap standing
# watch. Its call is relevance, not truth, so the cheap tier. A lookout can
# carry its own model override.
# LOOKOUT_MODEL=   # defaults to the cheap tier (OPENROUTER_MODELS.flash); needs OPENROUTER_API_KEY
# The budget of one lookout run (owls), the off-switch for funding lookout
# runs at all, and how often the Crossref retraction poll runs (0 disables).
# CAP_LOOKOUT_RUN_OWLS=0.05
# LOOKOUT_RUNS_ENABLED=true
# LOOKOUT_RETRACTION_POLL_HOURS=24
# Consistency sweeps (docs/allocation.md, "Consistency sweeps"): off unless
# "true"; the General mandate funds a standard (CONSISTENCY_MODEL, cheap
# tier) or a strong (CONSISTENCY_STRONG_MODEL) sweep per due partition,
# each priced at its expected cost per assessed node in the partition
# (observed, else model price) with its cap as the ceiling only.
# CONSISTENCY_SWEEPS_ENABLED=false
# CAP_CONSISTENCY_SWEEP_OWLS=2
# CAP_CONSISTENCY_SWEEP_STRONG_OWLS=10
# The solver (docs/mathematics.md §7) is strong-tier only and guarded in
# production like the envs above; SOLVER_MODEL is set in the MATHEMATICS:
# THE SOLVER section below.

# =============================================================================
# ELICIT CONNECTOR (issue #299)
# =============================================================================
# Scholarly search for the Claim Steward over Elicit's remote MCP server.
# Opt-in per deployment: empty/unset disables the connector entirely (the
# Steward's toolset omits the elicit_* tools). Calls cost real money beyond
# tokens.
# ELICIT_API_KEY=
# ELICIT_MCP_URL=https://elicit.com/api/mcp
# What one Elicit search costs in USD: stated in the tool, checked against
# the run's budget before a call, and metered per call.
# ELICIT_USD_PER_CALL=2

# =============================================================================
# PANGRAM TOOLS (src/llm/tools/pangram-tools.ts)
# =============================================================================
# AI-writing detection (pangram_check_ai) and original-source search
# (pangram_find_sources) for the Claim Steward and the researcher. Opt-in per
# deployment: empty/unset disables both tools. Billed per word.
# PANGRAM_API_KEY=
# PANGRAM_MODEL=pangram-4
# PANGRAM_API_URL=https://text.external-api.pangram.com
# PANGRAM_PLAGIARISM_API_URL=https://plagiarism.api.pangram.com
# What each analysis costs per word in USD, metered per call.
# PANGRAM_AI_USD_PER_WORD=0.0005
# PANGRAM_PLAGIARISM_USD_PER_WORD=0.0005
# The most words one call sends; the rest of the text is cut.
# PANGRAM_MAX_WORDS=1500

# =============================================================================
# DOMAIN SKILLS (docs/mathematics.md §3, §6.2)
# =============================================================================
# Prompt cache lifetime for the cached system blocks: 5m (default) or 1h.
# PROMPT_CACHE_TTL=5m

# =============================================================================
# FILE SETS AND THE SANDBOX (docs/file-sets.md; members-only deployments)
# =============================================================================
# Where uploaded file sets are kept: a directory the API can write and the
# sandbox mounts read-only. Empty = sets cannot be uploaded.
# FILE_SET_STORE_DIR=
# The root a directory must be under to be registered as a set where it
# lies, for data too large to upload. The sandbox mounts the same root
# read-only. The root has no label: an administrator registers a directory
# under it and says then what label its files get. Empty = no directory
# can be registered.
# FILE_SET_DIRECTORY_ROOT=
# The most bytes one uploaded set may hold (default 10 GiB).
# FILE_SET_UPLOAD_MAX_BYTES=10737418240
# The sandbox service's private base URL and bearer token (sandbox/). Empty
# URL = no sandbox: agents are offered no command, and are told why.
# SANDBOX_URL=
# SANDBOX_TOKEN=
# What an hour of a command's time is charged to the run's budget
# (micro-USD; default $0.05, the rate the model provider's sandbox is
# charged at). 0 charges nothing.
# SANDBOX_HOUR_COST_MICRO_USD=50000

# =============================================================================
# MATHEMATICS: LEAN CHECKER (docs/mathematics.md §5, §6.3)
# =============================================================================
# The lean-checker service's private base URL and bearer token. Empty URL =
# no checker: the Lean tools are absent, nothing publishes, nothing checks.
# LEAN_CHECKER_URL=
# LEAN_CHECKER_TOKEN=
# Metering: a check bills from the checker's wall time at this per-CPU-hour
# price (micro-USD; default ≈ one hour of a 4 vCPU Fargate task) plus a
# fixed per-job overhead, into llm_usage like token spend.
# LEAN_CPU_HOUR_COST_MICRO_USD=200000
# LEAN_CHECK_OVERHEAD_MICRO_USD=20000
# A published statement is public this long before any bounty binds to it;
# a challenge upheld during the period earns the fixed award (owls; granted
# by the operator by hand until it is mechanised).
# FORMALIZATION_REVIEW_PERIOD_DAYS=14
# FORMALIZATION_REVIEW_AWARD_OWLS=100

# =============================================================================
# MATHEMATICS: THE SOLVER (docs/mathematics.md §7)
# =============================================================================
# Strong tier only (the long-run loop needs effort, streaming, and the
# long-run betas); production must set it explicitly like the other
# load-bearing model envs.
# SOLVER_MODEL=claude-fable-5-2
# Kill switch: the solver worker exits its loop when not "true".
# SOLVER_ENABLED=false
# Durable daily spend cap on the solver, in owls, independent of any
# mandate; the lower cap applies during calibration runs.
# SOLVER_DAILY_CAP_OWLS=400
# SOLVER_CALIBRATION_DAILY_CAP_OWLS=100
# Per-attempt ceiling = cost estimate × (1 + fraction): the attempt's only
# budget. The model sees a token countdown derived from it.
# ATTEMPT_OVERAGE_FRACTION=0.25

# =============================================================================
# THE RESEARCHER (#298)
# =============================================================================
# The instrument an administrator launches for one bounded investigation.
# The launcher picks a tier per run; these say what each tier runs. The
# strong tier must be a model the long-run loop can drive.
# RESEARCHER_STRONG_MODEL=claude-fable-5-2
# RESEARCHER_STANDARD_MODEL=claude-sonnet-5-5
# RESEARCHER_CHEAP_MODEL=openai/gpt-6-luna
# Kill switch for launching new runs (a run in flight also polls the
# researcher_paused platform flag each turn). Off unless set to true.
# RESEARCHER_ENABLED=false
# A run's ceiling comes out of its launcher's budget (or a mandate's
# uncommitted budget). What remains: the durable daily cap on researcher spend
# no funder pays for (an operator's circuit breaker), and the wall-clock cap on
# one run, which exists because the launcher's run waits on it.
# RESEARCHER_DAILY_CAP_OWLS=50
# RESEARCHER_MAX_WALL_MINUTES=20
# A request run from the ledger has no launcher waiting on it; its budget
# bounds it, and this long backstop only ends a run that has stopped making
# progress.
# RESEARCHER_REQUEST_MAX_WALL_MINUTES=240
# The review cost a contribution from a mandate's research reserves against
# its delegated budget before there are recent reviews to average.
# CONTRIBUTION_REVIEW_ESTIMATE_USD=0.25
# What one contribution review and one arbitration may spend: the budget each
# run is shown and works to (the turn cap is only a far-off guard).
# CONTRIBUTION_REVIEW_BUDGET_USD=1
# ARBITRATION_BUDGET_USD=3
# Agents always traced regardless of TRACE_LEVEL (comma-separated): the
# solver's transcript is prize-review evidence.
# TRACE_ALWAYS_AGENTS=math_solver

# =============================================================================
# MATHEMATICS: BOUNTIES AND PRIZES (docs/mathematics.md §8)
# =============================================================================
# A bounty is owls (stored as micro-USD at cost, one owl per dollar of
# metered work) held against the posting mandate's escrow from the day it
# opens until it resolves. Per-claim bounds in owls; the maximum is raised
# only by configuration after counsel's items.
# MAX_BOUNTY_PER_CLAIM_OWLS=5000
# MIN_BOUNTY_PER_CLAIM_OWLS=250
# How much of the posting mandate's escrow the Grantmaker may commit to
# bounties per review pass and per UTC day, as fractions of the escrow.
# BOUNTY_ESCROW_FRACTION_PER_PASS=0.4
# BOUNTY_ESCROW_FRACTION_PER_DAY=0.5
# A posting at or above this (owls) waits for a person's confirmation.
# BOUNTY_AUTONOMY_THRESHOLD_OWLS=1000
# Withdrawal notice and default expiry, in days.
# BOUNTY_NOTICE_DAYS=30
# BOUNTY_DEFAULT_EXPIRY_DAYS=365
# Human sign-off before payment at or above this amount (owls) or importance.
# PRIZE_HUMAN_SIGNOFF_OWLS=1000
# PRIZE_HUMAN_SIGNOFF_IMPORTANCE=0.6
# The challenge window between acceptance and payment: small below the tier
# (owls), large at or above it, never under 14 days.
# PRIZE_CHALLENGE_WINDOW_DAYS_SMALL=14
# PRIZE_CHALLENGE_WINDOW_DAYS_LARGE=30
# PRIZE_WINDOW_TIER_OWLS=1000
# Days a winner has to complete identity, tax form, and screening.
# PRIZE_PAYEE_STEPS_DAYS=90
# Owls minted at cost into the prize-review job when a bounty opens, as a
# fraction of the bounty; the reserve counts against the posting mandate.
# PRIZE_REVIEW_RESERVE_FRACTION=0.10
# A statement defect exposed by a claimant earns this fraction of the
# bounty, capped (owls).
# PRIZE_DEFECT_AWARD_FRACTION=0.10
# PRIZE_DEFECT_AWARD_CAP_OWLS=500
# Owl prizes above this (owls) are granted in daily tranches of at most it.
# PRIZE_OWL_TRANCHE_OWLS=2000
# The prize-check worker: concurrent cold-lane checks, checks per day, the
# reclaim window (minutes) for a dead worker's row, and checker-error
# retries before check_error holds the statement's queue.
# PRIZE_CHECK_MAX_CONCURRENT=2
# PRIZE_CHECKS_PER_DAY=50
# PRIZE_CHECK_RECLAIM_MINUTES=30
# PRIZE_CHECK_MAX_ATTEMPTS=3
# Filing limits: per statement per 30 days, and per day platform-wide.
# PRIZE_CLAIMS_PER_STATEMENT_PER_30_DAYS=3
# PRIZE_CLAIMS_PER_DAY_PLATFORM=5
# The operator key (§8.11): bounty confirmations, prize-claim sign-offs,
# voids, screenings, owl grants, and check retries require it. NEVER
# deployed to the web tier; used only from the operator's own session.
# Empty = those routes are closed.
# MINERVAL_OPERATOR_KEY=
# The mandates' sizing (§10.7), read by the seed: the Mathematics mandate's
# escrow (owls at cost) and daily rate (must exceed one max attempt's
# prior), and the Mathematics prizes mandate's escrow, the only source of
# its prizes (no daily rate: its spend is prizes, paced by the fractions
# above).
# MATH_MANDATE_ESCROW_OWLS=2500
# MATH_MANDATE_DAILY_OWLS=200
# MATH_PRIZES_ESCROW_OWLS=2500

# =============================================================================
# PROCESSING SETTINGS
# =============================================================================
# MAX_DECOMPOSITION_DEPTH=5
# MATCHING_SIMILARITY_THRESHOLD=0.85
# Quantity caps to bound graph fan-out (0 = unlimited). Turn these DOWN for fast,
# cheap iteration on prompts; leave at 0 for a faithful full run.
# EXTRACTION_MAX_CLAIMS=0       # most-central claims per document
# Output budget per extraction call (tokens). A reasoning model that thinks in
# its output (GLM 5.3 Flash did) can exhaust the 16384 default on a long post and
# the source then fails to extract; raise it when the Extractor runs on one.
# EXTRACTION_MAX_TOKENS=16384
# MAX_SUBCLAIMS_PER_CLAIM=0     # subclaims per decomposition (tree width)

# =============================================================================
# GOVERNANCE SETTINGS
# =============================================================================
# ENABLE_CONTRIBUTIONS=false
# AUDIT_SAMPLE_RATE=0.05

# =============================================================================
# SQS QUEUES (production only -- local dev uses in-memory queues)
# =============================================================================
# SQS_CLAIM_PIPELINE_QUEUE=
# SQS_URL_EXTRACTION_QUEUE=
# SQS_CONTRIBUTION_QUEUE=
# SQS_ARBITRATION_QUEUE=
# SQS_STEWARD_QUEUE=
# SQS_AUDIT_QUEUE=

# =============================================================================
# THE MIRROR FEED (docs/mirror.md)
# =============================================================================
# A deployment publishes the feed, applies one, does both, or (with none of
# these set) does neither: no mirror route is mounted and no mirror worker runs.
#
# Publishing: cut signed batches of this deployment's public rows.
# MIRROR_PUBLISH=false
# MIRROR_SIGNING_KEY=             # Ed25519 private key, PEM; `npx tsx scripts/mirror.ts keygen`
# MIRROR_PUBLISH_INTERVAL_SECONDS=900
# MIRROR_BATCH_MAX_BYTES=24000000
#
# Applying: keep a read-only mirror of another graph, from its API or from a
# directory of batch files. Set one of the two.
# MIRROR_FEED_URL=
# MIRROR_FEED_DIR=
# MIRROR_FEED_API_KEY=            # presented when fetching a batch
# MIRROR_FEED_PUBLIC_KEYS=        # the feed's public key(s), comma-separated
# MIRROR_APPLY_INTERVAL_SECONDS=300
