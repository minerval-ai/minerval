{
  "//": "Self-contained (no extends into .wxt/): the repo's root vitest imports lib/anchor.ts, and an `extends` into extension/node_modules would break any tooling that hasn't installed the extension's deps (e.g. CI).",
  "exclude": ["node_modules", "build", ".wxt", ".output"],
  "include": ["./**/*.ts", "./**/*.tsx"],
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["chrome", "node"],
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "paths": {
      "~*": ["./*"]
    }
  }
}
