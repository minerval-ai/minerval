{
  "name": "minerval-extension",
  "displayName": "Minerval",
  "version": "0.2.0",
  "description": "Reads the page against the Minerval claim graph: flags misleading claims, explains unsettled ones, answers questions with citations.",
  "license": "Apache-2.0",
  "author": "Minerval",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "name": "Minerval",
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ]
  }
}
