{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w3id.org/minerval/mira/0.1/schema.json",
  "title": "Minerval MIRA export, profile 0.1",
  "description": "A bundle of MIRA records (questions, claims, evidence, sources, requests) exported from the Minerval graph by GET /claims/:claim_id/mira. Provisional: MIRA has not published a formal schema, so this profile follows the record types MIRA describes; docs/mira.md documents the mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mira_profile", "profile_version", "generated_at", "license", "publisher", "root", "records"],
  "properties": {
    "mira_profile": { "const": "https://w3id.org/minerval/mira/0.1" },
    "profile_version": { "const": "0.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "license": { "type": "string", "format": "uri" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "root": { "type": "string", "format": "uri" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/question" },
          { "$ref": "#/definitions/claim" },
          { "$ref": "#/definitions/evidence" },
          { "$ref": "#/definitions/source" },
          { "$ref": "#/definitions/request" }
        ]
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "format": "uri" },
    "attribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["organization", "agent", "contributor", "mandate"] },
          "role": { "enum": ["publisher", "assessor", "filer"] },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mv"],
      "properties": {
        "mv": { "type": "object" }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "target"],
        "properties": {
          "rel": {
            "enum": [
              "requires",
              "assumes",
              "supported_by",
              "contradicted_by",
              "specified_by",
              "defined_by",
              "related_to",
              "answers",
              "answered_by",
              "has_part",
              "presupposes",
              "excludes",
              "compatible_with"
            ]
          },
          "target": { "$ref": "#/definitions/id" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "links", "attribution"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "question" },
        "text": { "type": "string", "minLength": 1 },
        "links": { "$ref": "#/definitions/links" },
        "attribution": { "$ref": "#/definitions/attribution" },
        "extensions": { "$ref": "#/definitions/extensions" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "links", "attribution"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "claim" },
        "text": { "type": "string", "minLength": 1 },
        "links": { "$ref": "#/definitions/links" },
        "attribution": { "$ref": "#/definitions/attribution" },
        "extensions": { "$ref": "#/definitions/extensions" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "quote", "relation", "target", "source", "attribution"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "evidence" },
        "quote": { "type": ["string", "null"] },
        "relation": { "enum": ["supports", "disputes", "discusses", "asks", "answers", "states"] },
        "target": { "$ref": "#/definitions/id" },
        "source": { "$ref": "#/definitions/id" },
        "context": { "type": "string" },
        "answer": { "$ref": "#/definitions/id" },
        "attribution": { "$ref": "#/definitions/attribution" },
        "extensions": { "$ref": "#/definitions/extensions" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "url", "source_type", "attribution"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "source" },
        "title": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "source_type": { "type": ["string", "null"] },
        "attribution": { "$ref": "#/definitions/attribution" },
        "extensions": { "$ref": "#/definitions/extensions" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "ask", "why", "satisfied_by", "addressed_to", "state", "bears_on", "filed_at", "attribution"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "request" },
        "ask": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "satisfied_by": { "type": "string", "minLength": 1 },
        "addressed_to": { "type": ["string", "null"] },
        "state": { "enum": ["open", "addressed", "in_progress", "met", "declined", "withdrawn", "moot"] },
        "bears_on": { "type": "array", "items": { "$ref": "#/definitions/id" } },
        "filed_at": { "type": "string", "format": "date-time" },
        "attribution": { "$ref": "#/definitions/attribution" },
        "extensions": { "$ref": "#/definitions/extensions" }
      }
    }
  }
}
