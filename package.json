{
  "name": "minerval",
  "version": "0.1.0",
  "description": "Knowledge graph of claims with transparent provenance and validity assessment",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "corpus:fetch": "tsx scripts/corpus/fetch.ts",
    "corpus:reset": "tsx scripts/corpus/reset.ts",
    "corpus:run": "tsx scripts/corpus/run.ts",
    "corpus:report": "tsx scripts/corpus/report.ts",
    "corpus:score": "tsx scripts/corpus/score.ts",
    "corpus:compare": "tsx scripts/corpus/compare.ts",
    "corpus:runs": "tsx scripts/corpus/runs.ts",
    "corpus:snapshot": "tsx scripts/corpus/snapshot.ts",
    "corpus:golden": "tsx scripts/corpus/golden-matcher.ts",
    "corpus:calibrate": "tsx scripts/corpus/calibration.ts",
    "corpus:contributions": "tsx scripts/corpus/contributions.ts",
    "corpus:agreement": "tsx scripts/corpus/agreement.ts",
    "corpus:swap": "tsx scripts/corpus/swap.ts",
    "corpus:property": "tsx scripts/corpus/property.ts",
    "corpus:replay": "tsx scripts/corpus/replay.ts",
    "corpus:cascade": "tsx scripts/corpus/cascade.ts",
    "corpus:history": "tsx scripts/corpus/history.ts",
    "corpus:probe": "tsx scripts/corpus/probe.ts",
    "corpus:adopt": "tsx scripts/corpus/adopt.ts",
    "corpus:gate": "tsx scripts/corpus/gate.ts",
    "corpus:golden-canonical": "tsx scripts/corpus/golden-canonical.ts",
    "corpus:consistency": "tsx scripts/corpus/consistency.ts",
    "models:discover": "tsx scripts/models-discover.ts",
    "monitors": "tsx scripts/monitors.ts",
    "corpus:personas": "tsx scripts/corpus/personas.ts",
    "corpus:adversarial": "tsx scripts/corpus/adversarial.ts",
    "corpus:redteam": "tsx scripts/corpus/redteam.ts",
    "predictions": "tsx scripts/predictions.ts",
    "seed:platform-mandates": "tsx scripts/seed-platform-mandates.ts",
    "platform-mandates": "tsx scripts/platform-mandates.ts",
    "tags": "tsx scripts/tags.ts",
    "tags:seed": "tsx scripts/seed-tags-from-clusters.ts",
    "worker:solver": "tsx src/workers/solver-executor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "10.1.6",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.3.6",
    "fastify": "^5.2.0",
    "openai": "^7.43.0",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "stripe": "^23.0.1",
    "tsx": "^4.19.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
